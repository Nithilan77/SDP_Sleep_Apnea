# Virtual environment (machine-specific, ~1GB)
venv/

# PhysioNet Apnea-ECG dataset -- large (~580MB), public, downloadable.
# See CLAUDE.md / README.md for the source; not committed here.
data/physionet/

# Our own SensorTile recordings -- human-subject data, never committed
# (project rule: validation-only, never even used for training).
data/recordings/

# MESA (NSRR) -- gated human-subject data (Track B), never committed.
data/mesa/

# Python
__pycache__/
*.py[cod]

# Claude Code local session config
.claude/

# Large regenerable feature-study caches (exceed GitHub's 100MB file limit;
# rebuilt automatically by their runner scripts, e.g. method7_cwt_cnn.py /
# method8_spectrogram_cnn.py, on first run -- see results/feature_study/master_results.md).
results/feature_study/method7_cwt_scalogram/scalograms.npz
results/feature_study/method8_ecg_spectrogram/spectrograms.npz

# OS/editor cruft
.DS_Store
Thumbs.db
